void clock_init(void){

	RCC->CR |= (1 << 8);

	while(!(RCC->CR & (1 << 10)));

	FLASH->ACR |= (3 << 0);
	FLASH->ACR |= (1 << 8);
	FLASH->ACR |= (1 << 9);
	FLASH->ACR |= (1 << 10);


	RCC->PLLCFGR = 0;
	RCC->PLLCFGR |= (0b10 << 0);
	RCC->PLLCFGR |= (0x1 << 4);
	RCC->PLLCFGR |= (18 << 8);
	RCC->PLLCFGR |= (0b00 << 25);
	RCC->PLLCFGR |= (1 << 24);

	RCC->CR |= (1 << 24);
	while(!(RCC->CR & (1 << 25)));

	RCC->CFGR &= ~(0b11 << 0);
	RCC->CFGR |= (0b11 << 0);
	while((RCC->CFGR & (0b11 << 2)) != (0b11 << 2));

	RCC->CFGR &= ~(0xF << 4);
	RCC->CFGR &= ~(0b111 << 8);
	RCC->CFGR &= ~(0b111 << 11);

}

void TIM2_init_us(void){

	RCC->APB1ENR1 |= (1 << 0);

	TIM2->PSC = 71;
	TIM2->ARR = 0xFFFF;
	TIM2->CNT = 0;
	TIM2->CR1 = (1 << 0);
}

void delay_us(uint32_t us){
	TIM2->CNT = 0;
	while(TIM2->CNT < us);
}

void Delay_ms(uint32_t ms){
	for(uint32_t i = 0; i < ms; i++){
		delay_us(1000);
	}
}

void USART3_Init(void){

	RCC->AHB2ENR |= (1 << 2);	//GPIOC
	RCC->APB1ENR1 |= (1 << 18);	//USART3

	//Alternate Function PC4 and PC5 (AF7)
	GPIOC->MODER &= ~(0xF << 8);
	GPIOC->MODER |= (0x10 << 8);

	GPIOC->AFR[0] &= ~(0xFF << 16);
	GPIOC->AFR[0] |= (0x77 << 16);

	GPIOC->OSPEEDR &= ~(0xF << 8);
	GPIOC->OSPEEDR |= (0xF << 8);

	//Config USART1
	USART3->CR1 = 0;
	USART3->CR1 |= (0b11 << 2);

	USART3->BRR = 72000000/115200;

	USART3->CR1 |= (1 << 0);

}

void USART3_Write(char data){
	while(!(USART3->ISR & (1 << 7)));
	USART3->TDR = (data & 0xFF);

}

char USART3_Read(){
	while(!(USART3->ISR & (1 << 5)));
	return (char)(USART3->RDR & 0xFF);
}

int __io_putchar(char ch){

	USART3_Write(ch);
	return ch;
}

void integer_to_ascii(unsigned int Val, unsigned char *str)
{
    str[0] = Val/1000 + 0x30;
    Val    = Val%1000;
	str[1] = Val/100 + 0x30;
	Val    = Val%100;
	str[2] = Val/10 + 0x30;
	str[3] = Val%10 + 0x30;
	str[4] = '\0';
}

