void clock_init(void){

	RCC->CR |= (1 << 16);

	while(!(RCC->CR & (1 << 17)));

	FLASH->ACR |= (1 << 1);

	RCC->CFGR |= (1 << 16);

	RCC->CFGR &= ~(0xF << 18);
	RCC->CFGR |= (0x7 << 18);

	RCC->CR |= (1 << 24);
	while(!(RCC->CR & (1 << 25)));

	RCC->CFGR |= (1 << 1);
	while(!(RCC->CFGR & (1 << 3)));

}

void Systick_delay_ms(int delay){

	SysTick->LOAD = 71999;

	SysTick->VAL = 0;

	SysTick->CTRL |= (1 << 2);
	SysTick->CTRL |= (1 << 0);

	for(int i = 0; i < delay; i++){
		while(!(SysTick->CTRL & (1 << 16)));
	}
	SysTick->CTRL = 0;
}

void Systick_delay_us(int delay){

	SysTick->LOAD = 71;

	SysTick->VAL = 0;

	SysTick->CTRL |= (1 << 2);
	SysTick->CTRL |= (1 << 0);

	for(int i = 0; i < delay; i++){
		while(!(SysTick->CTRL & (1 << 16)));
	}
	SysTick->CTRL = 0;
}

void TIM2_Init(void)
{
    RCC->APB1ENR |= (1 << 0); // Enable TIM1 clock
    TIM2->PSC = 71;            // Prescaler to get 1MHz (72MHz / (71 + 1)) = 1 MHz
    TIM2->ARR = 0xFFFF;        // Auto reload max
    TIM2->CR1 |= (1 << 0);     // Enable TIM1
}

void microDelay(uint32_t us)
{
    TIM2->CNT = 0;
    while (TIM2->CNT < us);
}

