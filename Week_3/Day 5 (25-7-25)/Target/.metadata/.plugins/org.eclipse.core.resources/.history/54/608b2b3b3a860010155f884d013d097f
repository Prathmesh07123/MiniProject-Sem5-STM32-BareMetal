void DHT_GPIO_init_MCU_Start(){

	RCC->APB2ENR |= (1 << 3);

	GPIOB->CRH &= ~(0xF << 4);
	GPIOB->CRH |= (0x2 << 4);

}

void DHT_GPIO_init_DHT_Start(){

	RCC->APB2ENR |= (1 << 3);

	GPIOB->CRH &= ~(0xF << 4);
	GPIOB->CRH |= (0x8 << 4);
//	GPIOA->ODR &= ~(1 << 4);
	GPIOA->ODR |= (1 << 9);

}

void DHT11_Init(){
	DHT_GPIO_init_MCU_Start();
	GPIOA->ODR &= ~(1 << 9);
	TIM1_ms_delay(20);
	GPIOA->ODR |= (1 << 9);
	TIM1_us_delay(30);
	DHT_GPIO_init_DHT_Start();

//	while(DHT11_Read_bit());
//	while(!(DHT11_Read_bit()));
//	while(DHT11_Read_bit());
}

uint8_t DHT11_Read_bit(){
	return (GPIOA->IDR & (1 << 9)) != 0; //send high = 1 or low = 0
}

uint8_t DHT11_Response_check(){

	uint8_t Response = 0;
	TIM1_us_delay(40);
	if(!DHT11_Read_bit()){
		TIM1_us_delay(80);
		if(DHT11_Read_bit()){
			Response = 1;
		}
	}
	pMillis = GetTick();
	cMillis = GetTick();
	while((DHT11_Read_bit()) && (pMillis + 2 > cMillis)){
		cMillis = GetTick();
	}
	return Response;
}

uint8_t DHT11_Read_Byte(){
	uint8_t i, result = 0;
//	printf("Byte is Reading....\n");

	for(i = 0; i < 8; i++){

		pMillis = GetTick();
		cMillis = GetTick();
		while((!DHT11_Read_bit()) && (pMillis + 2 > cMillis)){
			cMillis = GetTick();
		}

		TIM1_us_delay(40);

		if(DHT11_Read_bit()){
			result |= (1 << (7 - i));
//			printf("Data 1\n");
		}
		else{
			result &= ~(1 << (7 - i));
		}
//		printf("2i = %d\n", i);
		pMillis = GetTick();
		cMillis = GetTick();
		while((DHT11_Read_bit()) && (pMillis + 2 > cMillis)){
//			printf("i = %d\n", i);
//			TIM2_ms_delay(1000);
			cMillis = GetTick();
		}
//		printf("i = %d\n", i);

	}
	return result;
}

void GET_DHT11_Data(uint8_t *humadity, uint8_t *temperature){
	uint8_t RH_integral, RH_decimal, T_integral, T_decimal, checksum;

	DHT11_Init();

	if(DHT11_Response_check()){

//		printf("response from DHT11!\n");
//		printf("response from DHT112!\n");



		RH_integral = DHT11_Read_Byte();
//		printf("H : %d\n", RH_integral);
		RH_decimal = DHT11_Read_Byte();
		T_integral = DHT11_Read_Byte();
//		printf("T : %d\n", T_integral);
		T_decimal = DHT11_Read_Byte();
		checksum = DHT11_Read_Byte();

		if (checksum == (RH_integral + RH_decimal + T_integral + T_decimal)){
			*humadity = RH_integral;
			*temperature = T_integral;
//			printf("H : %d\n", RH_integral);
//			printf("T : %d\n", T_integral);
		}
		else{
			*humadity = 0;
			*temperature = 0;
			printf("CheckSum Error\n");
		}

	}
	else{
		*humadity = 0;
		*temperature = 0;
		printf("Response Error\n");
	}

}



