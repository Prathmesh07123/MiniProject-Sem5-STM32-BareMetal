void clock_init(void){

	RCC->CR |= (1 << 16);

	while(!(RCC->CR & (1 << 17)));

	FLASH->ACR |= (1 << 1);

	RCC->CFGR |= (1 << 16);

	RCC->CFGR &= ~(0xF << 18);
	RCC->CFGR |= (0x7 << 18);

	RCC->CR |= (1 << 24);
	while(!(RCC->CR & (1 << 25)));

	RCC->CFGR |= (1 << 1);
	while(!(RCC->CFGR & (1 << 3)));

}

void SysTick_Init(void){

	SysTick->LOAD = 71999;

	SysTick->VAL = 0;

	SysTick->CTRL |= (1 << 0);
	SysTick->CTRL |= (1 << 1);
	SysTick->CTRL |= (1 << 2);
}

void SysTick_Handler(void){
	msTicks++;
}

uint32_t GetTick(void){

    return msTicks;
}

void Systick_delay_ms(int delay){

	SysTick->LOAD = 71999;

	SysTick->VAL = 0;

	SysTick->CTRL |= (1 << 2);
	SysTick->CTRL |= (1 << 0);

	for(int i = 0; i < delay; i++){
		while(!(SysTick->CTRL & (1 << 16)));
	}
	SysTick->CTRL = 0;
}

void Systick_delay_us(int delay){

	SysTick->LOAD = 71;

	SysTick->VAL = 0;

	SysTick->CTRL |= (1 << 2);
	SysTick->CTRL |= (1 << 0);

	for(int i = 0; i < delay; i++){
		while(!(SysTick->CTRL & (1 << 16)));
	}
	SysTick->CTRL = 0;
}

void TIM1_Init(){
  RCC->APB2ENR |= (1 << 11);
  TIM1->PSC = 72 - 1;
  TIM1->ARR = 0xFFFF;
  TIM1->CNT = 0;
  TIM1->CR1 = 1;
}

void TIM1_us_delay(int delay){
	TIM1->CNT = 0;
	while(TIM1->CNT < delay);
}

void TIM1_ms_delay(int delay){
	for(int i = 0; i < delay; i++){
		TIM1_us_delay(1000);
	}
}

