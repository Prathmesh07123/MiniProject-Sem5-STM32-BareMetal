

#include <stdint.h>
#include <stm32l4xx.h>

void LoRa_GPIO_Init(void);
void SPI1_Init(void);
void LoRa_SS_LOW(void);
void LoRa_SS_High(void);
uint8_t SPI_Tranfer(uint8_t data);
uint8_t LoRa_ReadReg(uint8_t add);
void LoRa_WriteReg(uint8_t add, uint8_t val);
void LoRa_Reset(void);

void LoRa_SS_LOW(void){
	GPIOA->ODR &= ~(1 << 4);
}

void LoRa_SS_High(void){
	GPIOA->ODR |= (1 << 4);
}

void LoRa_Reset(void){
	GPIOC->ODR &= ~(1 << 5);
	for(int i = 0; i < 8000; i++);
	GPIOC->ODR |= (1 << 5);
	for(int i = 0; i < 8000; i++);
}

void LoRa_GPIO_Init(void){

	RCC->AHB2ENR |= (1 << 1);
	RCC->AHB2ENR |= (1 << 2);


	//SPI1 SS PA4
	GPIOA->MODER &= ~(0b11 << 8);
	GPIOA->MODER |= (0b01 << 8);
	GPIOA->OSPEEDR |= (0b11 << 8);
	GPIOA->ODR |= (1 << 4);

	//SPI1 SCK PA5
	GPIOA->MODER &= ~(0b11 << 10);
	GPIOA->MODER |= (0b10 << 10);
	GPIOA->AFR[0] &= ~(0xF << 20);
	GPIOA->AFR[0] |= (0x5 << 20);
	GPIOA->OSPEEDR |= (0b11 << 10);

	//SPI1 MISO PA6
	GPIOA->MODER &= ~(0b11 << 12);
	GPIOA->MODER |= (0b10 << 12);
	GPIOA->AFR[0] &= ~(0xF << 24);
	GPIOA->AFR[0] |= (0x5 << 24);
	GPIOA->OSPEEDR |= (0b11 << 12);

	//SPI1 MOSI PA7
	GPIOA->MODER &= ~(0b11 << 14);
	GPIOA->MODER |= (0b10 << 14);
	GPIOA->AFR[0] &= ~(0xF << 28);
	GPIOA->AFR[0] |= (0x5 << 28);
	GPIOA->OSPEEDR |= (0b11 << 14);

	//LoRa Reset Pin PC5
	GPIOC->MODER &= ~(0b11 << 10);
	GPIOC->MODER |= (0b01 << 10);
	GPIOC->ODR |= (1 << 5);

	//LoRa DIO0 Pin PC6 IP
	GPIOC->MODER &= ~(0b11 << 12);

}

void SPI1_Init(void){

	RCC->APB2ENR |= (1 << 12);

	// Fclk/4 == 4MHz
	SPI1->CR1 &= ~(0b111 << 3);
	SPI1->CR1 |= (0b001 << 3);

	// CPOL = 1 , CPHA = 1
	SPI1->CR1 |= (0b11 << 0);

	// Full Duplex
	SPI1->CR1 &= ~(1 << 10);

	// Master Configuration
	SPI1->CR1 |= (1 << 2);

	// MSB First
	SPI1->CR1 &= ~(1 << 7);

	// 8bit Data Formet
	SPI1->CR2 &= ~(0xF << 8);
	SPI1->CR2 |= (0x7 << 8);

	//Software slave
	SPI1->CR1 |= (1 << 8);
	SPI1->CR1 |= (1 << 9);

	//Enable SPI
	SPI1->CR1 |= (1 << 6);


}

uint8_t SPI_Tranfer(uint8_t data){

	while(!(SPI1->SR & 0b10));
	SPI1->DR = data;
	while(!(SPI1->SR & 0b01));
	return (uint8_t)SPI1->DR;
}

uint8_t LoRa_ReadReg(uint8_t add){

	uint8_t val;
	LoRa_SS_LOW();
	SPI_Tranfer(add & 0x7F);
	val = SPI_Tranfer(0x00);
	LoRa_SS_High();
	return val;
}

void LoRa_WriteReg(uint8_t add, uint8_t val){
	LoRa_SS_LOW();
	SPI_Tranfer(add | 0x80);
	SPI_Tranfer(val);
	LoRa_SS_High();
}

int LoRa_Bringup(void){

	LoRa_Reset();
	uint8_t version = LoRa_ReadReg(0x42);

	if(version != 0x12){
		return -1;
	}

	LoRa_WriteReg(0x01, 0x00);
	LoRa_WriteReg(0x01, 0x80);
	LoRa_WriteReg(0x06, 0x6C);
	LoRa_WriteReg(0x07, 0x80);
	LoRa_WriteReg(0x08, 0x00);

	return 0;
}



